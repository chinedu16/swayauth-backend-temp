<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <link rel="icon" href="https://api.swayauth.com/public/logo.png" type="image/png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    body,
    html {
      margin: 0;
    }

    @media screen and (prefers-color-scheme: dark) {
      html {
        background-color: black;
        color: white;
        margin: 0;
      }

      .text-white {
        color: white;
      }

      .spinner {
        fill: white;
      }

    }

    @media screen and (prefers-color-scheme: light) {
      html {
        background-color: white;
        color: black;
      }

      .text-white {
        color: black;
      }

      .spinner {
        fill: black;
      }
    }

    .hide {
      display: none !important;
    }

    .show {
      display: block !important;
    }

    .p-1 {
      padding: 1rem;
    }

    .p-2 {
      padding: 2rem;
    }

    .p-3 {
      padding: 3rem;
    }

    .px-1 {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .px-2 {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .px-3 {
      padding-left: 3rem;
      padding-right: 3rem;
    }

    .py-1 {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .py-2 {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .py-3 {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .pt-1 {
      padding-top: 0.5rem;
    }

    .pt-2 {
      padding-top: 2rem;
    }

    .pt-3 {
      padding-top: 3rem;
    }

    .pb-1 {
      padding-bottom: 1rem;
    }

    .pb-2 {
      padding-bottom: 2rem;
    }

    .pb-3 {
      padding-bottom: 3rem;
    }

    .pl-1 {
      padding-left: 0.5rem;
    }

    .pl-2 {
      padding-left: 2rem;
    }

    .pl-3 {
      padding-left: 3rem;
    }

    .pr-1 {
      padding-right: 0.5rem;
    }

    .pr-2 {
      padding-right: 2rem;
    }

    .pr-3 {
      padding-right: 3rem;
    }

    .ml-4 {
      margin-left: 4rem;
    }

    .mr-4 {
      margin-right: 4rem;
    }

    .vh-100 {
      height: 100svh;
    }

    .d-flex {
      display: flex;
    }

    .flex-column {
      flex-direction: column;
    }

    .flex-wrap {
      flex-wrap: wrap;
    }

    .d-block {
      display: block;
    }

    .d-inline-block {
      display: inline-block;
    }

    .text-sm {
      font-size: 0.65rem;
    }

    .text-md {
      font-size: 1rem;
    }

    .text-lg {
      font-size: 1.35rem;
    }

    .border {
      border: 1px solid lightgray;
    }

    .text-xl {
      font-size: 1.6rem;
    }

    .justify-content-center {
      justify-content: center;
    }

    .justify-content-space {
      justify-content: space-between;
    }

    .justify-content-end {
      justify-content: flex-end;
    }

    .align-items-center {
      align-items: center;
    }

    .align-items-end {
      align-items: flex-end;
    }

    .max-w-lg {
      max-width: 768px;
    }

    .max-w-md {
      max-width: 540px;
    }

    .max-w-sm {
      max-width: 360px;
    }

    .max-w-xs {
      max-width: 240px;
    }

    .max-w-xxs {
      max-width: 120px;
    }

    .max-w-xxxs {
      max-width: 40px;
    }

    .max-w-xxxxs {
      max-width: 30px;
    }

    .max-w-xxxxs {
      max-width: 30px;
    }

    .rounded-1 {
      border-radius: 0.75rem;
    }

    .rounded-2 {
      border-radius: 2rem;
    }

    .spin {
      animation: spin 1s linear infinite;
    }

    .min-h-4 {
      min-height: 4rem;
    }

    .min-h-2-5 {
      min-height: 2.5rem;
    }

    #loader {
      width: 100%;
      position: fixed;
      height: 0.2rem;
      background: #96b3f0;
    }

    #loader::after {
      content: '';
      position: absolute;
      width: 20%;
      height: 100%;
      background-color: #2464EB;
      animation: flow 2s linear infinite;
    }

    @keyframes flow {
      from {
        left: 0;
      }

      to {
        left: 100%;
      }
    }

    @keyframes spin {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(359deg);
      }
    }
  </style>
</head>

<body>
  {{#if alert}}
  <main id="success" class="max-w-md p-2 show main">
    <h4 class="website"></h4>
    <div class="d-flex min-h-10 border px-1 py-1 rounded-1  align-items-center justify-content-space">
      <div class="d-flex align-items-center">
        <svg class="spin" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 4335 4335" width="25" height="25">
          <path class="spinner"
            d="M3346 1077c41,0 75,34 75,75 0,41 -34,75 -75,75 -41,0 -75,-34 -75,-75 0,-41 34,-75 75,-75zm-1198 -824c193,0 349,156 349,349 0,193 -156,349 -349,349 -193,0 -349,-156 -349,-349 0,-193 156,-349 349,-349zm-1116 546c151,0 274,123 274,274 0,151 -123,274 -274,274 -151,0 -274,-123 -274,-274 0,-151 123,-274 274,-274zm-500 1189c134,0 243,109 243,243 0,134 -109,243 -243,243 -134,0 -243,-109 -243,-243 0,-134 109,-243 243,-243zm500 1223c121,0 218,98 218,218 0,121 -98,218 -218,218 -121,0 -218,-98 -218,-218 0,-121 98,-218 218,-218zm1116 434c110,0 200,89 200,200 0,110 -89,200 -200,200 -110,0 -200,-89 -200,-200 0,-110 89,-200 200,-200zm1145 -434c81,0 147,66 147,147 0,81 -66,147 -147,147 -81,0 -147,-66 -147,-147 0,-81 66,-147 147,-147zm459 -1098c65,0 119,53 119,119 0,65 -53,119 -119,119 -65,0 -119,-53 -119,-119 0,-65 53,-119 119,-119z" />
        </svg>
        <small class="d-inline-block pl-1">Redirecting...</small>
      </div>
      <div class="d-flex flex-column justify-content-center ">
        <div class="pl-1">
          <img src="https://api.swayauth.com/public/logo.png" class="max-w-xxxs d-block min-h-2-5" alt="" />
        </div>
        <div class="text-sm pt-1"><a href="https://swayauth.com" class="text-white" />Home</a> | <a class="text-white"
            href="https://swayauth.com/privacy" />Privacy</a>
        </div>
      </div>
    </div>
    <h3 class="d-flex align-items-center ">
      <img src="https://api.swayauth.com/public/shield.png" class="max-w-xxxxs d-inline-block pr-1" alt="" />
      <span>
        Secure authentication managed by Swayauth
      </span>
    </h3>
    <div><span class="website">Application</span> needs access to your information using {{type}} authentication.</div>
  </main>
  <main id="error" class="hide main">
    <div class="vh-100 d-flex flex-column justify-content-center align-items-center">
      <img src="https://api.swayauth.com/public/alert.png" class="max-w-xxs d-block" alt="" />
      <div>Unable to process information. <span id="errorMessage">Please try again later</span>!</div>
    </div>
  </main>
  {{else}}
  <div id="loader"></div>
  {{/if}}
  <script>
    let timer;
    let time = 0;
    const error = document.getElementById('error');
    const errorMessage = document.getElementById('errorMessage');
    const success = document.getElementById('success');
    const website = document.getElementsByClassName('website');
    const oauthUrlBase = "{{{oauthUrlBase}}}"
    const oauthUrl = new URLSearchParams(window.location.search)?.get('client_id');
    const renderErrorMessage = () => {
      success.classList.add('hide')
      success.classList.toggle('show')
      error.classList.toggle('hide')
    }
    const prevUrl = document?.referrer ? new URL(document?.referrer)?.origin : ''
    if (prevUrl) {
      for (let e of website) {
        e.textContent = prevUrl
      }
    }
    timer = setInterval(() => {
      time++
    }, 1000)
    if (oauthUrl) {
      fetch(oauthUrlBase + oauthUrl)
        .then(async (r) => r.ok ? r.json() : Promise.reject(await r.json()))
        .then(({ data }) => {
          clearInterval(timer)
          if (data?.google || data?.facebook) {
            if (time < 4) {
              setTimeout(() => {
                window.location.href = data?.google || data?.facebook;
              }, 3000 - (time * 1000))
            } else {
              window.location.href = data?.google || data?.facebook;
            }
          } else {
            renderErrorMessage()
          }
        })
        .catch(err => {
          if (err?.message) errorMessage.textContent = err?.message
          clearInterval(timer)
          renderErrorMessage()
        })
    } else {
      renderErrorMessage()
    }
  </script>
</body>

</html>